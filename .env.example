# Any OpenAI-compatible chat-completions endpoint.
# DeepSeek:
MICRO_BASE_URL=https://api.deepseek.com
MICRO_API_KEY=sk-...
MICRO_MODEL=deepseek-chat

# OpenAI:
# MICRO_BASE_URL=https://api.openai.com/v1
# MICRO_MODEL=gpt-4o-mini

# --- optional ---

# Several model ids for the GUI's model picker (GET /api/models)
# MICRO_MODELS=deepseek-chat,deepseek-reasoner

# USD per 1M tokens, for cost tracking. `INPUT_CACHED` is the discounted rate for
# input served from the provider's prompt cache — set it or cost is overstated.
MICRO_PRICE_INPUT=0.27
MICRO_PRICE_OUTPUT=1.10
MICRO_PRICE_INPUT_CACHED=0.027

# Cap on one tool result, in characters (about 3k tokens by default)
# MICRO_MAX_TOOL_OUTPUT=12000

# Give every sub-agent its own git worktree
# MICRO_ISOLATE=1

# MICRO_DATA_DIR=~/.micro-harness
# MICRO_SERVER_TOKEN=...

# --- web search backends (optional; the GUI can switch engines live) ---
# DEEPSEEK_API_KEY=sk-...   # DeepSeek Search API; same key as the chat API
# BOCHA_API_KEY=sk-...      # 博查
# MICRO_SEARXNG_URL=https://your-searxng.example
