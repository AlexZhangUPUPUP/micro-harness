{
  "name": "micro-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A complete, plugin-based coding-agent harness: own agent loop, multi-agent orchestration, server + CLI + GUI, MCP/ACP.",
  "license": "MIT",
  "workspaces": ["packages/*"],
  "scripts": {
    "start": "bun packages/core/src/cli.ts",
    "test": "bun test",
    "verify": "bun scripts/verify-features.ts",
    "typecheck": "tsc --noEmit",
    "build:bin": "bun build --compile --outfile dist/micro-harness packages/core/src/cli.ts"
  },
  "engines": {
    "bun": ">=1.1"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
