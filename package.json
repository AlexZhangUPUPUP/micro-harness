{
  "name": "micro-harness",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A complete, plugin-based coding-agent harness: own agent loop, multi-agent orchestration, server + CLI + GUI, MCP/ACP.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "bun packages/core/src/cli.ts",
    "test": "bun test",
    "verify": "bun scripts/verify-features.ts",
    "dev": "scripts/dev.sh",
    "ui": "scripts/dev.sh --single",
    "typecheck": "tsc --noEmit",
    "build:bin": "bun build --compile --outfile dist/micro-harness packages/core/src/cli.ts",
    "eval": "bun scripts/evals/run.ts",
    "eval:mock": "bun scripts/evals/run.ts --mock",
    "docs:build": "bun scripts/build-docs.ts && pagefind --site site"
  },
  "engines": {
    "bun": ">=1.1"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/node": "^22.10.0",
    "marked": "^18.1.1",
    "pagefind": "^1.5.2",
    "typescript": "^5.7.2"
  }
}
